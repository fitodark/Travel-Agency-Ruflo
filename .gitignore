# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# Node
node_modules/
dist/
*.tsbuildinfo

# Respaldos locales y artefactos de impresión
backups/
*.bin

# Export semanal de reportes (F8) — se genera, no se versiona
exports/

# Runtime de ruflo y configuracion local de agentes (no forman parte del sistema)
.agents/
.claude/
.claude-flow/
.swarm/

# Artefacto de runtime de ruflo (indice vectorial)
ruvector.db

# Hojas de cálculo fuente: se versiona el .md derivado (p. ej. knowledge/sucursales.md),
# no el binario ni sus archivos de bloqueo de Excel.
*.xlsx
~$*.xlsx
