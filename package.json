{
  "name": "donaji",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de venta de boletos y reservaciones — Donaji Travel Agency",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "tsx scripts/limpiar-dev.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "printer:fake": "tsx src/printing/tools/fake-printer.ts",
    "printer:poc": "tsx src/printing/tools/poc-ticket.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:status": "tsx src/db/migrate.ts --status",
    "backup": "tsx src/backup/run.ts",
    "backup:hourly": "tsx src/backup/run.ts --no-verify",
    "backup:verify": "tsx src/backup/run.ts --verify-only",
    "db:migrate:nube": "tsx src/db/migrate.ts --target nube",
    "db:migrate:ambos": "tsx src/db/migrate.ts --target ambos",
    "db:status:nube": "tsx src/db/migrate.ts --status --target nube",
    "sync:poc": "tsx src/sync/poc.ts",
    "printer:probe": "tsx src/printing/tools/probe.ts",
    "api": "tsx src/api/main.ts",
    "seed:admin": "tsx scripts/sembrar-admin.ts",
    "materializar": "tsx scripts/materializar.ts",
    "export:semanal": "tsx scripts/export-semanal.ts",
    "sync": "tsx scripts/sync.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  }
}
